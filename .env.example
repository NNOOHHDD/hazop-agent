# Copy to .env and fill in. Never commit .env.

# Which LLM runs the agent: anthropic | openai | claude_cli | fake
HAZOP_LLM_PROVIDER=anthropic
# Model for that provider. Empty = provider default (anthropic: claude-opus-5-5, claude_cli: opus).
# The openai provider has no default: set a model name here.
HAZOP_LLM_MODEL=

# Optional: a different provider / model for matching and judging in hazop_eval
HAZOP_EVAL_PROVIDER=
HAZOP_EVAL_MODEL=

# API keys (placeholders)
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Anthropic options
HAZOP_ANTHROPIC_EFFORT=high
HAZOP_ANTHROPIC_FALLBACK=default

# P&ID image: cap on the long side in pixels
HAZOP_PID_MAX_SIDE=2000

# claude_cli options (optional)
# CLAUDE_CLI_PATH=
# HAZOP_CLI_TIMEOUT=1800
